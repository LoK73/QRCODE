# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000
DATABASE_PATH=data/commesse.db

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────
# Token permanente di un System User con permesso whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID del numero business (WhatsApp Manager → Numeri di telefono)
WHATSAPP_PHONE_NUMBER_ID=
# Una stringa a tua scelta: la stessa va inserita nella configurazione del webhook su Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret dell'app Meta (Impostazioni app → Di base): verifica la firma dei webhook
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v27.0

# ─── WordPress ───────────────────────────────────────────────────────────
WP_URL=https://www.tua-agenzia.it
# Utente dedicato al bot, con ruolo Editor (o Shop manager se usi WooCommerce)
WP_USER=bot-whatsapp
# Utenti → Profilo → Password applicazioni
WP_APP_PASSWORD=
# Tipi di contenuto modificabili (slug). Aggiungi i tuoi, es. viaggio,offerta
WP_POST_TYPES=post,page
# true per permettere la modifica dei prezzi dei prodotti WooCommerce
WP_WOOCOMMERCE=false

# ─── Claude (Anthropic) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (più alto = più accurato, più lento e costoso)
ANTHROPIC_EFFORT=medium
# Filtro economico (facoltativo): un modello piccolo decide se un messaggio riguarda il sito
# prima di passarlo al modello principale. Riduce i costi nei gruppi chiacchierati.
# Consigliato: claude-haiku-5-5. Vuoto = spento. Misuralo prima con "npm run eval".
PREFILTER_MODEL=
# Tetto mensile di spesa AI in dollari (0 = nessun tetto): superato, il bot smette di analizzare
AI_MONTHLY_BUDGET_USD=0
# Scheda del cliente per l'AI: chi è, cosa vende, parole ricorrenti, campi personalizzati
CLIENT_PROFILE="Agenzia di viaggi. Il prezzo dei viaggi è nel campo ACF 'prezzo'."

# ─── Chi può usare il bot ────────────────────────────────────────────────
# group_id dei gruppi autorizzati, separati da virgola (li trovi nel log alla prima scrittura)
ALLOWED_GROUPS=
# Numeri che possono scrivere al bot in privato (formato 393331234567)
ALLOWED_SENDERS=
# Numeri dei responsabili che possono approvare / ripristinare le commesse
APPROVERS=
# Facoltativo: se impostato (es. #sito) il bot legge solo i messaggi che iniziano così
TRIGGER_PREFIX=

# ─── Comportamento ───────────────────────────────────────────────────────
# Dopo quante ore una proposta rimasta senza ok scade
PROPOSAL_TTL_HOURS=24
# Fuso orario per le date nei messaggi e per le modifiche programmate
TIMEZONE=Europe/Rome
# false per non controllare la pagina pubblica dopo ogni modifica
VERIFY_PUBLIC=true

# ─── Vocali (facoltativo) ────────────────────────────────────────────────
# Per attivare i vocali basta la chiave di Groq (console.groq.com → API Keys).
# Attenzione: i vocali dello staff vengono inviati a questo fornitore.
TRANSCRIPTION_API_KEY=
# Predefiniti (Groq): cambiali solo per usare un altro servizio con lo stesso formato
# (POST multipart con file/model/language, risposta {"text": "..."}).
# TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# TRANSCRIPTION_LANGUAGE=it
