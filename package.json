{
  "name": "agenzia-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot WhatsApp che raccoglie commesse da un gruppo e aggiorna il sito WordPress dell'agenzia di viaggi",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "crea-gruppo": "tsx --env-file=.env scripts/create-group.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "verifica": "tsx --env-file=.env scripts/verifica.ts",
    "start:piattaforma": "node dist/src/worker.js",
    "dev:piattaforma": "tsx watch --env-file=.env src/worker.ts",
    "demo": "tsx --env-file-if-exists=.env.demo scripts/demo.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoK73/QRCODE.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
