# ─── Database ────────────────────────────────────────────────────────────
# Connessione a Postgres (Supabase → Project Settings → Database → Connection pooling).
# Consigliato un utente dedicato "dashboard_app" senza permessi propri: vedi README.
DATABASE_URL=postgresql://dashboard_app.[PROGETTO]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ─── Login (Supabase Auth) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROGETTO].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Facoltativa: serve solo per invitare nuovi utenti dalla pagina Utenti
SUPABASE_SERVICE_ROLE_KEY=

# ─── Credenziali dei siti ────────────────────────────────────────────────
# La stessa chiave usata dal bot (openssl rand -base64 32)
CREDENTIALS_KEY=

# ─── Solo in locale, senza Supabase ──────────────────────────────────────
# Con DEV_AUTH=1 e senza NEXT_PUBLIC_SUPABASE_URL il login diventa una scelta dell'utente
# tra quelli presenti nel database. Non usarlo mai in produzione.
# DEV_AUTH=1
